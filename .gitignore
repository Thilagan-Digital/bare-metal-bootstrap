# Local private inventory & secrets — NEVER commit these. Your real host
# addresses, cluster names, and storage topology live here, kept out of the
# public repo.
private-inventory/
inventory.local/

# Ansible Vault files and vault-password files
vault.yml
*.vault
*.vault.yml
**/vault.yml
.vault_pass
.vault_pass.txt

# Ansible run cruft
*.retry

# OS / editor cruft
.DS_Store
*.swp
*~
.idea/
.vscode/

# Per-user coding-agent state. Choosing "don't ask again" on a permission prompt
# saves the approved command verbatim into settings.local.json, including any
# token, key or connection string in it. Never commit these; the shared,
# reviewed config is .claude/settings.json (tracked).
.claude/settings.local.json
.claude/*.local.json
CLAUDE.local.md
.mcp.local.json
.codex/
.gemini/settings.local.json
.cursor/mcp.json
